# Public Cognito identifiers — safe to commit real values to .env.local,
# never secrets. Get them from `terraform output` in infra/live after deploy:
#   cognito_user_pool_id  → VITE_COGNITO_USER_POOL_ID
#   cognito_app_client_id → VITE_COGNITO_APP_CLIENT_ID
#   api_base_url          → VITE_API_BASE_URL
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_API_BASE_URL=
